# ── Sharing / proposals (server-mediated) ───────────────────────────────────
# Turn the sharing UI on in the client. The server must also have the two keys
# below for it to actually work.
NEXT_PUBLIC_SHARE_ENABLED=1

# Server-only Supabase service-role key (Project Settings → API → service_role).
# NEVER prefix with NEXT_PUBLIC — it must not reach the browser. Bypasses RLS,
# so the table can (and should) deny all anon access. See SHARING.md.
SUPABASE_SERVICE_ROLE_KEY=

# Shared team password reps type at login to unlock create/list/delete.
TRACE_REP_KEY=

# Optional: override the Supabase project URL (defaults to the bundled project).
# NEXT_PUBLIC_SUPABASE_URL=https://bvgmnounfupalekjfzuu.supabase.co
